{
  "info": {
    "_postman_id": "c4eb878c-abca-5f34-9551-e07ca0bc3409",
    "name": "Crop Map - API prepared",
    "description": "Luồng thật theo app.py. Chạy folder 01 trước; Delay 400 ms trong Collection Runner. Không cần Authorization. Mỗi POST analyses thực hiện suy luận mới trên vùng nhỏ. Folder 02 kiểm tra lỗi và folder 03 thử hủy thủ công.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "patch_id",
      "value": "10003",
      "type": "string"
    },
    {
      "key": "season",
      "value": "2018–2019",
      "type": "string"
    },
    {
      "key": "geometry",
      "value": "{\"type\": \"Polygon\", \"coordinates\": [[[-0.362, 49.304], [-0.36, 49.304], [-0.36, 49.302], [-0.362, 49.302], [-0.362, 49.304]]]}",
      "type": "string"
    },
