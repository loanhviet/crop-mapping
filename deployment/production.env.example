# Copy to ignored .env.production; never put registry credentials here.
# Replace with YOUR Docker Hub namespace and verified digest after approved publication.
CROP_IMAGE=loanhviet070105/crop-mapping@sha256:REPLACE_WITH_VERIFIED_DIGEST
CROP_DATA_DIR=./data
CROP_DEVICE=cpu
CROP_RESULTS_VOLUME=crop-mapping-results
CROP_BIND=127.0.0.1
CROP_PORT=8000
# Conservative CPU caps matching local deployment; tune only after measuring.
CROP_THREADS=2
CROP_CPUS=2
CROP_MEMORY_LIMIT=2g
