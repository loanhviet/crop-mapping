# Copy to ignored .env.oracle in the repository root. No credentials are required.
# Set once at bootstrap to a GHCR digest; afterwards CD (deploy.py) rewrites this line.
CROP_IMAGE=ghcr.io/loanhviet/crop-mapping@sha256:REPLACE_WITH_DIGEST_FROM_CD_SUMMARY
CROP_PORT=18080
# Absolute host paths are recommended on the VM. Keep tracked config/license with best.pth.
CROP_DATA_DIR=./data
CROP_WEIGHTS_DIR=./weights
# A fresh OCI installation gets its own results volume. For migration, retain the ACTUAL existing name.
CROP_RESULTS_VOLUME=crop-mapping-oracle-results
CROP_THREADS=2
CROP_CPUS=2
CROP_MEMORY_LIMIT=2g
