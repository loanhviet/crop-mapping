# Safe local defaults. No credentials are required for prepared imagery.
# Compose interpolates these three keys from .env:
CROP_BIND=127.0.0.1
CROP_PORT=8000
CROP_THREADS=2

# Native imagery.setting() reads this key from process environment, then .env.
# Supplied Compose explicitly sets prepared/cpu; these entries do not override it.
CROP_SOURCE=prepared

# Native paths/device must be exported in the shell (os.getenv does not read .env).
# CROP_DEVICE=cpu
# CROP_DATA_DIR=/absolute/path/to/data
# CROP_WEIGHTS_DIR=/absolute/path/to/weights
# CROP_RESULTS_DIR=/absolute/path/to/results
# run.sh uses HOST and PORT; they differ from Compose CROP_BIND/CROP_PORT.

# Optional native GEODES acquisition: supply your own key locally.
GEODES_API_KEY=
GEODES_REFLECTANCE=FRE
GEODES_MAX_DOWNLOAD_GB=64
GEODES_MAX_CLOUD_PERCENT=30
CROP_MAX_GRID_PIXELS=160000
