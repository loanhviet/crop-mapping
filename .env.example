# Safe local defaults. No credentials are required for prepared imagery.
# Compose interpolates these three keys from .env:
CROP_BIND=127.0.0.1
CROP_PORT=8000
CROP_THREADS=2

# Native imagery.setting() reads this key from process environment, then .env.
# Local compose.yaml pins prepared/cpu. Production remains prepared and reads CROP_DEVICE.
CROP_SOURCE=prepared

# Native paths/device must be exported in the shell (os.getenv does not read .env).
# Production Compose: HOST bind paths (relative to the Compose file, or absolute).
# Inside the container the application still reads /app/data and /app/weights.
CROP_DATA_DIR=./data
CROP_WEIGHTS_DIR=./weights
# CPU is the supported device for this image.
CROP_DEVICE=cpu
# Production-only image: replace unpublished with a verified SHA tag or @sha256 digest.
CROP_IMAGE=loanhviet070105/crop-mapping:unpublished
# Optional production caps; adjust down on small Docker Desktop VMs.
CROP_CPUS=2
CROP_MEMORY_LIMIT=2g
CROP_RESULTS_VOLUME=crop-mapping-results
# CROP_RESULTS_DIR=/absolute/path/to/results
# run.sh uses HOST and PORT; they differ from Compose CROP_BIND/CROP_PORT.

# Optional native GEODES acquisition: supply your own key locally.
GEODES_API_KEY=
GEODES_REFLECTANCE=FRE
GEODES_MAX_DOWNLOAD_GB=64
GEODES_MAX_CLOUD_PERCENT=30
CROP_MAX_GRID_PIXELS=160000
