# Default demo: prepared Sentinel-2 COG and PASTIS; no API key required.
CROP_SOURCE=prepared
CROP_BIND=127.0.0.1
CROP_PORT=8000
CROP_THREADS=2

# Optional live acquisition mode outside the supplied PASTIS Compose deployment.
# Copy to .env and paste your own key locally. Never commit .env.
# https://geodes-portal.cnes.fr → My information → Generate
GEODES_API_KEY=

# THEIA terrain-corrected reflectance; confirm against the training dataset.
GEODES_REFLECTANCE=FRE

# Limits for this local first version. Whole-scene archives can be large.
GEODES_MAX_DOWNLOAD_GB=64
# Skip highly cloudy tiles before spending a download request.
GEODES_MAX_CLOUD_PERCENT=30
CROP_MAX_GRID_PIXELS=160000
